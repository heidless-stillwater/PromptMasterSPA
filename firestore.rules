rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Access (Recursive for Credits/Metadata)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy mapping (if any collection used userId directly)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Master Registry Primary Collections
    match /blueprints/{id} {
      allow read, write: if request.auth != null;
    }

    match /projects/{id} {
      allow read, write: if request.auth != null;
    }

    // Sovereign Registry (Policies & Compliance)
    match /policies/{policyId} {
      allow read: if true;
    }

    // Ecosystem Exemplars (League Entries)
    match /leagueEntries/{entryId} {
      allow read: if true;
    }

    // System Configuration & Global Secrets
    match /system/{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
