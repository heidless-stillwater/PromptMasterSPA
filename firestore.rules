rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User Profile Access (Recursive for Credits/Metadata)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy mapping (if any collection used userId directly)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Master Registry Primary Collections
    match /blueprints/{id} {
      allow read, write: if request.auth != null;
    }

    match /projects/{id} {
      allow read, write: if request.auth != null;
    }

    // Sovereign Registry (Policies & Compliance)
    match /policies/{policyId} {
      allow read: if true;
    }

    // Ecosystem Exemplars (League Entries)
    match /leagueEntries/{entryId} {
      allow read, list: if true;
    }

    // Generated variations and assets
    match /images/{imageId} {
      allow read, list: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /generatedImages/{imageId} {
      allow read, list: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // System Configuration & Global Secrets
    match /system/{document=**} {
      allow read, write: if request.auth != null;
    }

    match /system_config/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Safe System Config (Public Read)
    match /system_config/protection {
      allow read: if true;
    }
    match /system_config/moderation {
      allow read: if true;
    }
  }
}
